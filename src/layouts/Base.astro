---
// Layout de base vape24be mobile — tête SEO (lang + hreflang) + nav.
// Mobile-first, rendu dans le style du template astro-ecommerce (noir/or/rouge).
import "../styles/global.css";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import MobileBottomNav from "../components/MobileBottomNav.astro";
import SearchDialog from "../components/SearchDialog.astro";
import { SITE_NAME, SITE_URL, SITE_TITLE, SITE_DESCRIPTION } from "../lib/site";
import { ORG_ADDRESS } from "../lib/site";
import { LANGS, LANG_LOCALES, stripLang } from "../lib/i18n";
import type { Lang } from "../lib/i18n";

interface Crumb {
  name: string;
  /** URL absolue ou relative (dernier item = sans lien, la page courante). */
  url?: string;
}

interface Props {
  /** Langue de la page (nl | fr | de). Par défaut SITE_LANG. */
  lang?: Lang;
  title?: string;
  description?: string;
  /** Chemin canonique absolu (ex. /produktis/xyz). Par défaut on reprend l'URL courante. */
  canonicalPath?: string;
  /** Objet JSON-LD supplémentaire (SiteGraph / Produit / Ville…). */
  jsonLd?: object;
  /** Schema principal (OnlineStore par défaut). */
  schema?: object;
  /** Image sociale OG (URL absolue ou chemin local). Défaut = image de marque générée. */
  ogImage?: string;
  /** Type OG (website / product / article). Défaut website. */
  ogType?: string;
  /** Fil d'ariane → émet un BreadcrumbList JSON-LD + est repris dans og:title.log. */
  breadcrumb?: Crumb[];
  /** Ne pas afficher la barre basse mobile (ex. checkout). */
  hideBottomNav?: boolean;
  /** Balise robots noindex (pages utilitaires : panier, récap…) — exclues du référencement. */
  noindex?: boolean;
}

const {
  lang = "nl",
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  canonicalPath,
  jsonLd,
  schema,
  ogImage = `${SITE_URL}/images/og-default.png`,
  ogType = "website",
  breadcrumb,
  hideBottomNav = false,
  noindex = false,
} = Astro.props;

const canonical = canonicalPath == null ? Astro.url.pathname : canonicalPath;
const canonicalUrl = canonical.startsWith("http") ? canonical : `${SITE_URL}${canonical}`;

// Chemins de base SANS préfixe langue (pour hreflang alternates).
// canonicalPath est déjà préfixé (ex. /fr/produktis/x) → on retire /fr.
const basePath = stripLang(lang, canonicalPath ?? Astro.url.pathname);
const hrefLangs = LANGS.map((l) => ({
  lang: LANG_LOCALES[l],
  url: `${SITE_URL}/${l}${basePath}`,
}));

const ogImageUrl = ogImage.startsWith("http") ? ogImage : `${SITE_URL}${ogImage}`;

// BreadcrumbList JSON-LD (schema.org) si un fil d'ariane est fourni.
const breadcrumbSchema = breadcrumb && breadcrumb.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumb.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        ...(c.url ? { item: c.url.startsWith("http") ? c.url : `${SITE_URL}${c.url}` } : {}),
      })),
    }
  : null;

const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "OnlineStore",
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  url: SITE_URL,
  image: `${SITE_URL}/images/og-default.png`,
  address: {
    "@type": "PostalAddress",
    streetAddress: ORG_ADDRESS.street,
    addressLocality: ORG_ADDRESS.city,
    addressRegion: ORG_ADDRESS.region,
    postalCode: ORG_ADDRESS.postalCode,
    addressCountry: ORG_ADDRESS.country,
  },
  geo: { "@type": "GeoCoordinates", latitude: ORG_ADDRESS.lat, longitude: ORG_ADDRESS.lng },
};

const pageSchema = schema ?? defaultSchema;
const jsonLdObjects = [pageSchema, ...(jsonLd ? [jsonLd] : []), ...(breadcrumbSchema ? [breadcrumbSchema] : [])];
---

<!doctype html>
<html lang={LANG_LOCALES[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {hrefLangs.map((h) => <link rel="alternate" hreflang={h.lang} href={h.url} />)}
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/${lang}${basePath}`} />
    <meta property="og:locale" content={LANG_LOCALES[lang]} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex" />}
    {
      jsonLdObjects.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)
    }
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <Header lang={lang} />
    <Sidebar lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <MobileBottomNav lang={lang} hide={hideBottomNav} />
    <SearchDialog lang={lang} />
  </body>
</html>
