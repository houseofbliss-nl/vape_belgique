---
// Index des zones de livraison — toutes les villes desservies (SEO interne).
import Base from "../../../layouts/Base.astro";
import cities from "../../../data/cities.json";
import { SITE_NAME, SITE_URL, TELEGRAM_URL } from "../../../lib/site";
import { t, p, langStaticPaths, cityName } from "../../../lib/i18n";
import type { Lang } from "../../../lib/i18n";

export function getStaticPaths() { return langStaticPaths(); }
interface Props { lang: Lang; }
const { lang } = Astro.props;

const zoneTitle = t(lang, "page.deliveryTitle");

// ItemList JSON-LD — les villes desservies (maillage interne vers les pages villes).
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: zoneTitle,
  itemListElement: cities.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: cityName(lang, c),
    url: `${SITE_URL}${p(lang, `/miestai/${c.slug}`)}`,
  })),
};
---
<Base
  lang={lang}
  title={`${zoneTitle} — ${SITE_NAME}`}
  description={t(lang, "page.deliveryLead", { name: SITE_NAME })}
  canonicalPath={p(lang, "/miestai")}
  jsonLd={itemListSchema}
>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <h1 class="text-3xl font-black text-neutral-900 md:text-5xl">{zoneTitle}</h1>
    <p class="mt-3 text-neutral-600">{t(lang, "page.deliveryLead", { name: SITE_NAME })}</p>

    <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
      {cities.map((c) => (
        <a
          href={p(lang, `/miestai/${c.slug}`)}
          class="flex items-center justify-between rounded-lg border border-neutral-200 p-4 hover:border-primary"
        >
          <span class="font-semibold text-neutral-900">{cityName(lang, c)}</span>
          <svg class="h-5 w-5 text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
        </a>
      ))}
    </div>

    <a
      href={TELEGRAM_URL}
      target="_blank"
      rel="noopener"
      class="mt-8 inline-flex items-center gap-2 rounded-lg bg-neutral-900 px-6 py-3 text-sm font-bold text-white hover:bg-neutral-800"
    >
      {t(lang, "page.deliveryCta")}
    </a>
  </div>
</Base>