---
// Page récapitulative de commande — portée de OrderSummary.tsx vapespot,
// adaptée aux COULEURS/DESIGN de CE site (LT, EUR, remise crypto 10%, min 30 €).
// 1. Jūsų produktai (table)  2. Numatoma suma + crypto 10%  3. Pristatymo būdas
// 4. Adresas  5. Mokėjimo būdai (SEPA, kortelė, kripto, dovanų kortelė)
// 6. CTA → Telegram (désactivé sous le minimum), copie du message au clic.
import Base from "../../layouts/Base.astro";
import { SLIM_CATALOG } from "../../lib/slim-catalog";
import { SITE_NAME } from "../../lib/site";
import { MIN_ORDER_EUR } from "../../lib/checkout";
import { t, p, LANGS } from "../../lib/i18n";
import type { Lang } from "../../lib/i18n";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang }, props: { lang } }));
}
interface Props { lang: Lang; }
const { lang } = Astro.props;

const orderTitle = t(lang, "order.title");
const all = SLIM_CATALOG;
---
<Base
  lang={lang}
  title={`${orderTitle} — ${SITE_NAME}`}
  description={t(lang, "footer.blurb")}
  canonicalPath={p(lang, "/order-summary")}
  noindex
>
  <div class="mx-auto max-w-3xl px-3 py-6 pb-10 md:py-8">
    <h1 class="mb-6 text-3xl font-black text-neutral-900 md:text-4xl">{orderTitle}</h1>

    <div id="app" class="space-y-3">
      <p class="text-neutral-500">{t(lang, "cart.loading")}</p>
    </div>
  </div>
</Base>

<script type="application/json" id="slim-data" set:html={JSON.stringify(all)}></script>

<script>
  import { getItems } from "../../lib/store";
  import { packPrice } from "../../lib/packs";
  import { fmtEur, tRuntime, pRuntime } from "../../lib/i18n-client";
  import { buildTelegramMessage, buildTelegramUrl } from "../../lib/telegram";
  import { MIN_ORDER_EUR as MIN } from "../../lib/checkout";
  import { CRYPTO_DISCOUNT_PERCENT } from "../../lib/packs";

  const appEl = document.getElementById("app")!;
  const INDEX = JSON.parse(document.getElementById("slim-data")!.textContent || "[]");
  const byId = (id) => INDEX.find((p) => p.id === id);

  // Méthode de livraison sélectionnée (état de module — survit au re-render).
  let selectedMethod: "courier" | "post" = "courier";

  // Rendu complet — recalculé à chaque changement (méthode / adresse).
  function render() {
    const items = getItems();
    const lines = items
      .map((i) => ({ item: i, product: byId(i.productId) }))
      .filter((l) => Boolean(l.product));

    if (lines.length === 0) {
      appEl.innerHTML = `
        <div class="rounded-lg border border-neutral-200 bg-white p-10 text-center space-y-3">
          <p class="text-neutral-600">${tRuntime("order.emptyTitle")}</p>
          <a href="${pRuntime("/")}" class="inline-block rounded-lg bg-black px-5 py-2.5 text-sm font-semibold text-[#F2C94C]">${tRuntime("cart.startShopping")}</a>
        </div>`;
      return;
    }

    const total = lines.reduce((s, l) => s + (packPrice(l.product.price_eur, l.item.quantity) ?? l.product.price_eur), 0);
    const cryptoTotal = total - (total * CRYPTO_DISCOUNT_PERCENT) / 100;
    const method = selectedMethod;
    const address = (document.getElementById("address") || {}).value || "";
    const esc = (s) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    const checkoutLines = lines.map((l) => ({ product: l.product, quantity: l.item.quantity }));
    const msg = buildTelegramMessage(checkoutLines, address, method as "courier" | "post");
    const url = buildTelegramUrl(msg);
    const under = Math.max(0, MIN - total);

    appEl.innerHTML = `
      <!-- Jūsų produktai -->
      <div class="rounded-lg border border-neutral-200 bg-white p-4">
        <div class="flex items-baseline gap-2 mb-3">
          <h2 class="font-bold text-neutral-900 text-[15px]">${tRuntime("order.yourProducts")}</h2>
          <span class="text-xs text-[#9E9E9E]">(${lines.length} ${lines.length === 1 ? tRuntime("order.productSingular") : tRuntime("order.productPlural")})</span>
        </div>
        <div class="grid grid-cols-[1fr_auto_auto_auto] gap-x-3 text-[11px] text-[#9E9E9E] uppercase tracking-wide pb-2 border-b border-neutral-100">
          <span>${tRuntime("order.productsCol")}</span><span class="text-right">${tRuntime("order.priceCol")}</span><span class="text-center">${tRuntime("order.qtyCol")}</span><span class="text-right">${tRuntime("order.sumCol")}</span>
        </div>
        <ul>
          ${lines.map((l, i) => {
            const lineTotal = packPrice(l.product.price_eur, l.item.quantity) ?? l.product.price_eur;
            return `
            <li class="grid grid-cols-[1fr_auto_auto_auto] gap-x-3 items-center py-3 ${i < lines.length - 1 ? "border-b border-neutral-100" : ""}">
              <div class="flex items-center gap-3 min-w-0">
                <div class="w-[52px] h-[52px] shrink-0">
                  <img src="${l.product.image}" alt="${l.product.title}" loading="lazy" class="w-full h-full object-contain">
                </div>
                <p class="text-[14px] font-semibold text-neutral-900 leading-tight line-clamp-2 min-w-0">${l.product.title}</p>
              </div>
              <span translate="no" class="text-right text-[13px] text-[#6E6E73] whitespace-nowrap">${fmtEur(l.product.price_eur)}</span>
              <span class="text-center text-[13px] text-[#6E6E73] whitespace-nowrap">× ${l.item.quantity}</span>
              <span translate="no" class="text-right text-[14px] font-bold text-neutral-900 whitespace-nowrap">${fmtEur(lineTotal)}</span>
            </li>`;
          }).join("")}
        </ul>
      </div>

      <!-- Total estimé -->
      <div class="rounded-lg border border-neutral-200 bg-white p-4 flex items-center justify-between">
        <div>
          <p class="font-bold text-neutral-900 text-[15px]">${tRuntime("order.estSubtotal")}</p>
          <p class="text-xs text-[#6E6E73] mt-0.5">${tRuntime("order.productsOnly")}</p>
        </div>
        <p translate="no" class="text-[26px] font-extrabold text-neutral-900 leading-none">${fmtEur(total)}</p>
      </div>

      <!-- Crypto / remise -->
      <div class="flex items-center justify-between rounded-lg border border-[#E3D9FF] bg-[#F6F2FF] px-4 py-3">
        <p class="flex items-center gap-1.5 text-[13px] font-bold text-[#ED2939]">
          <svg class="h-[17px] w-[17px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11.767 19.089c4.924.868 6.14-6.025 1.216-6.894m-1.216 6.894L5.86 18.047m5.908 1.042-.347 1.97m1.563-8.864c4.924.869 6.14-6.025 1.215-6.893m-1.215 6.893-3.94-.694m5.155-6.2L8.29 4.26m5.908 1.042.348-1.97M7.48 20.364l3.126-17.727"/></svg>
          ${tRuntime("order.cryptoCardPay")}
        </p>
        <p translate="no" class="text-[14px] font-extrabold text-[#ED2939]">${fmtEur(cryptoTotal)} <span class="font-bold text-[12px]">${tRuntime("order.savePercent",{p:CRYPTO_DISCOUNT_PERCENT})}</span></p>
      </div>
      <p translate="no" class="text-[12px] text-neutral-500 text-center">${tRuntime("order.minOrder",{price:fmtEur(MIN)})}</p>

      <!-- Règlement avant livraison -- zone livraison -->
      <div class="rounded-lg border border-neutral-200 bg-white p-5 space-y-4">
        <div class="flex items-start gap-3">
          <span class="text-[#ED2939] font-extrabold text-lg leading-none mt-0.5">✔</span>
          <div>
            <p class="font-extrabold text-[#ED2939] text-[17px] leading-tight">${tRuntime("order.payBeforeShip")}</p>
            <p class="text-[13px] text-[#6E6E73] mt-1 leading-snug">${tRuntime("order.processedAfterPay")}</p>
          </div>
        </div>

        <!-- Méthode de livraison -->
        <div class="space-y-2">
          <p class="text-[13px] font-extrabold text-neutral-900">${tRuntime("order.chooseDelivery")}</p>
          <button type="button" data-method="courier" class="scanel ${method === "courier" ? "sel" : ""} w-full text-left rounded-xl px-4 py-3.5 flex items-center gap-3 border-2 transition-colors">
            <span class="shrink-0 h-10 w-10 rounded-full bg-neutral-100 flex items-center justify-center ${method === "courier" ? "text-[#ED2939]" : "text-neutral-600"}">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"></path><path d="M15 18H9"></path><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"></path><circle cx="17" cy="18" r="2"></circle><circle cx="7" cy="18" r="2"></circle></svg>
            </span>
            <span class="flex-1 min-w-0">
              <span class="text-[15px] font-bold text-neutral-900 block">${tRuntime("order.courier")}</span>
              <span class="text-[12px] text-[#6E6E73] block">${tRuntime("order.courierSub")}</span>
            </span>
            <span class="shrink-0 h-5 w-5 rounded-full border-2 flex items-center justify-center transition-colors"><span class="dot h-2.5 w-2.5 rounded-full"></span></span>
          </button>
          <button id="method-post" type="button" data-method="post" class="scanel ${method === "post" ? "sel" : ""} w-full text-left rounded-xl px-4 py-3.5 flex items-center gap-3 border-2 transition-colors">
            <span class="shrink-0 h-10 w-10 rounded-full bg-neutral-100 flex items-center justify-center ${method === "post" ? "text-[#ED2939]" : "text-neutral-600"}">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7.5 4.27 9 5.15"></path><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path><path d="m3.3 7 8.7 5 8.7-5"></path><path d="M12 22V12"></path></svg>
            </span>
            <span class="flex-1 min-w-0">
              <span class="text-[15px] font-bold text-neutral-900 block">${tRuntime("order.post")}</span>
              <span class="text-[12px] text-[#6E6E73] block">${tRuntime("order.postSub")}</span>
            </span>
            <span class="shrink-0 h-5 w-5 rounded-full border-2 flex items-center justify-center transition-colors"><span class="dot h-2.5 w-2.5 rounded-full"></span></span>
          </button>
        </div>

        <!-- Adresse -->
        <div class="rounded-lg border border-[#FCDBE0] bg-[#FFF5F6] px-4 py-3.5 space-y-2">
          <p class="flex items-center gap-1.5 text-[14px] font-extrabold text-neutral-900">
            <svg class="h-4 w-4 shrink-0 text-[#ED2939]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            ${tRuntime("order.enterAddress")}
          <textarea id="address" placeholder="${tRuntime("order.addressPlaceholder")}" rows="2"
            class="w-full text-[14px] border border-[#FCDBE0] bg-white rounded-lg px-3 py-2 text-neutral-900 placeholder:text-[#D8A0A4] focus:outline-none focus:border-[#ED2939] resize-none">${esc(address)}</textarea>
        </div>

        <!-- Méthodes de paiement -->
        <div>
          <p class="text-[13px] font-extrabold text-neutral-900 mb-2">${tRuntime("order.payMethods")}</p>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
            <div class="flex items-center gap-1.5">
              <span class="h-9 w-9 rounded-full bg-[#F5F5F5] flex items-center justify-center text-neutral-700">
                <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 22h18"></path><path d="M6 18v-7"></path><path d="M10 18v-7"></path><path d="M14 18v-7"></path><path d="M18 18v-7"></path><path d="m12 2 8 5H4z"></path></svg>
              </span>
              <div><p class="text-[12px] font-bold text-neutral-900">${tRuntime("order.bankTransfer")}</p><p class="text-[10px] text-[#6E6E73]">IBAN / SWIFT</p></div>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="h-9 w-9 rounded-full bg-[#F5F5F5] flex items-center justify-center text-neutral-700">
                <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11.767 19.089c4.924.868 6.14-6.025 1.216-6.894m-1.216 6.894L5.86 18.047m5.908 1.042-.347 1.97m1.563-8.864c4.924.869 6.14-6.025 1.215-6.893m-1.215 6.893-3.94-.694m5.155-6.2L8.29 4.26m5.908 1.042.348-1.97M7.48 20.364l3.126-17.727"/></svg>
              </span>
              <div><p class="text-[12px] font-bold text-neutral-900">${tRuntime("order.crypto")}</p><p class="text-[10px] text-[#6E6E73]">${saveSub}</p></div>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="h-9 w-9 rounded-full bg-[#F5F5F5] flex items-center justify-center text-neutral-700">
                <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"></rect><path d="M12 8v13"></path><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"></path><path d="M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8"></path><path d="M16.5 8a2.5 2.5 0 0 0 0-5C13 3 12 8 12 8"></path></svg>
              </span>
              <div><p class="text-[12px] font-bold text-neutral-900">${tRuntime("order.giftCard")}</p><p class="text-[10px] text-[#6E6E73]">${saveSub}</p></div>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA Telegram -->
      ${under > 0 ? `
        <div class="w-full">
          <button type="button" disabled class="flex items-center justify-center gap-2 w-full bg-neutral-200 text-neutral-500 py-4 text-[15px] font-semibold rounded-lg cursor-not-allowed">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path></svg>
            ${tRuntime("order.checkout")}
          </button>
          <p class="text-center text-[13px] text-[#E53E3E] mt-2 font-bold">${tRuntime("order.minOrderNotice",{min:fmtEur(MIN),more:fmtEur(under)})}</p>
        </div>` : `
        <a id="checkout" href="${url}" target="_blank" rel="noopener noreferrer"
          style="background:#000;color:#F2C94C"
          class="flex items-center justify-center gap-2 w-full rounded-lg bg-black text-[#F2C94C] py-4 text-[15px] font-bold hover:bg-neutral-900 transition-colors">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path></svg>
          ${tRuntime("order.checkout")}
        </a>`}
      <p class="flex items-center justify-center gap-1.5 text-xs text-[#9E9E9E]">
        <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        ${tRuntime("order.confirmationNote")}
      </p>

      <input type="hidden" id="clone-msg" value="">
    `;

    // Livraison UI — sélection visuelle (couleurs CE site)
    appEl.querySelectorAll("[data-method]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const m = btn.dataset.method;
        selectedMethod = m === "post" ? "post" : "courier";
        document.querySelectorAll("[data-method]").forEach((b) => b.classList.remove("sel"));
        btn.classList.add("sel");
        render();
      });
    });

    // CTA Telegram → copie le message au clic (comme vapespot)
    document.getElementById("checkout")?.addEventListener("click", async (e) => {
      e.preventDefault();
      // Relecture des valeurs + message final (méthode & adresse courantes).
      const address = document.getElementById("address").value || "";
      const final = buildTelegramMessage(checkoutLines, address, selectedMethod);
      const finalUrl = buildTelegramUrl(final);
      try { await navigator.clipboard.writeText(final); } catch {}
      window.open(finalUrl, "_blank", "noopener");
    });
  }

  // Sous-libellé remise « crypto / bon » — parenthèses retirées.
  const saveSub = tRuntime("order.savePercent", { p: CRYPTO_DISCOUNT_PERCENT }).replace(/[()]/g, "");

  render();
</script>