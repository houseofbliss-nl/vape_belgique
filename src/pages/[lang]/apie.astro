---
import Base from "../../layouts/Base.astro";
import { SITE_NAME, TELEGRAM_URL } from "../../lib/site";
import { t, p, langStaticPaths } from "../../lib/i18n";
import type { Lang } from "../../lib/i18n";

export function getStaticPaths() { return langStaticPaths(); }
interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<Base lang={lang} title={`${t(lang, "page.aboutTitle")} — ${SITE_NAME}`} canonicalPath={p(lang, "/apie")}>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-3xl font-black text-neutral-900 md:text-5xl">{t(lang, "page.aboutTitle")}</h1>
    <p class="mt-4 text-neutral-600">
      {t(lang, "page.aboutLead", { name: SITE_NAME })}
    </p>
    <p class="mt-3 text-neutral-600">
      {t(lang, "page.aboutSecond")}
    </p>
    <a href={TELEGRAM_URL} target="_blank" rel="noopener"
      style="background:#000;color:#F2C94C"
      class="mt-6 inline-flex items-center gap-2 rounded-lg bg-black px-6 py-3 text-sm font-bold hover:bg-neutral-900">
      {t(lang, "page.contactCta")}
    </a>
  </div>
</Base>