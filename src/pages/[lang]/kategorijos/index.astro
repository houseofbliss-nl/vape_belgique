---
// Index des catégories — basé sur la TAXONOMIE (comptes réels du classifieur) + « visi ».
import Base from "../../../layouts/Base.astro";
import { TAXONOMY } from "../../../lib/taxonomy";
import { SITE_NAME } from "../../../lib/site";
import { t, p, langStaticPaths } from "../../../lib/i18n";
import type { Lang } from "../../../lib/i18n";
import { getProducts } from "../../../lib/catalog";

export function getStaticPaths() { return langStaticPaths(); }
interface Props { lang: Lang; }
const { lang } = Astro.props;
const prods = getProducts(lang);

const entries = [
  { id: "visi", label: t(lang, "footer.allProducts"), count: prods.length, image: prods[0]?.image || "" },
  ...TAXONOMY.map((c) => ({ id: c.id, label: t(lang, `cat.${c.id}`), count: c.count, image: c.image })),
];
---
<Base
  lang={lang}
  title={`${t(lang, "category.categoriesTitle")} — ${SITE_NAME}`}
  description={t(lang, "footer.blurb")}
  canonicalPath={p(lang, "/kategorijos")}
>
  <div class="mx-auto max-w-6xl px-3 py-6">
    <h1 class="mb-6 text-3xl font-black text-neutral-900 md:text-5xl">{t(lang, "category.categoriesTitle")}</h1>
    <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
      {entries.map((c) => (
        <a href={p(lang, `/kategorijos/${c.id}`)} class="group overflow-hidden rounded-lg border border-neutral-200 bg-white">
          <img src={c.image} alt={c.label} loading="lazy" class="aspect-square w-full object-cover" width="480" height="480" />
          <div class="p-3">
            <p class="font-semibold text-neutral-900 group-hover:text-primary">{c.label}</p>
            <p class="text-xs text-neutral-500">{t(lang, "category.productsCount", { count: c.count })}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>