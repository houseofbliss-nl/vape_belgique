---
import Base from "../../layouts/Base.astro";
import { SITE_NAME } from "../../lib/site";
import { t, p, langStaticPaths } from "../../lib/i18n";
import type { Lang } from "../../lib/i18n";

export function getStaticPaths() { return langStaticPaths(); }
interface Props { lang: Lang; }
const { lang } = Astro.props;
const card = "rounded-lg border border-neutral-200 p-4";
const title = "font-bold text-neutral-900";
const body = "mt-1 text-sm text-neutral-600";
---
<Base lang={lang} title={`${t(lang, "page.newsTitle")} — ${SITE_NAME}`} canonicalPath={p(lang, "/zinios")}>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-3xl font-black text-neutral-900 md:text-5xl">{t(lang, "page.newsTitle")}</h1>
    <p class="mt-4 text-neutral-600">{t(lang, "page.newsIntro")}</p>
    <div class="mt-8 space-y-4">
      <div class={card}>
        <p class={title}>{t(lang, "page.news1Title")}</p>
        <p class={body}>{t(lang, "page.news1Body")}</p>
      </div>
      <div class={card}>
        <p class={title}>{t(lang, "page.news2Title")}</p>
        <p class={body}>{t(lang, "page.news2Body")}</p>
      </div>
    </div>
  </div>
</Base>