---
// Index des zones de livraison — toutes les villes desservies (SEO interne).
import Base from "../../layouts/Base.astro";
import cities from "../../data/cities.json";
import { SITE_NAME, SITE_URL, TELEGRAM_URL } from "../../lib/site";

// ItemList JSON-LD — les 25 villes desservies (renforce le maillage vers les pages villes).
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Pristatymo zonos",
  itemListElement: cities.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    url: `${SITE_URL}/miestai/${c.slug}`,
  })),
};
---
<Base
  title={`Pristatymo zonos — ${SITE_NAME}`}
  description="VAPELT pristato elektronines cigaretes ir vapingo produktus visoje Lietuvoje. Peržiūrėkite pristatymo zonas ir miestus."
  canonicalPath="/miestai"
  jsonLd={itemListSchema}
>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <h1 class="text-3xl font-black text-neutral-900 md:text-5xl">Pristatymo zonos</h1>
    <p class="mt-3 text-neutral-600">
      VAPELT pristato visoje Lietuvoje — kurjeriu arba paštu. Pasirinkite savo miestą, kad sužinotumėte daugiau.
    </p>

    <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
      {cities.map((c) => (
        <a
          href={`/miestai/${c.slug}`}
          class="flex items-center justify-between rounded-lg border border-neutral-200 p-4 hover:border-primary"
        >
          <span class="font-semibold text-neutral-900">{c.name}</span>
          <svg class="h-5 w-5 text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
        </a>
      ))}
    </div>

    <a
      href={TELEGRAM_URL}
      target="_blank"
      rel="noopener"
      class="mt-8 inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-sm font-bold text-white hover:bg-red-700"
    >
      Užsisakyti per Telegram
    </a>
  </div>
</Base>
