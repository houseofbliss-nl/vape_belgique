---
// Index des catégories — basé sur la TAXONOMIE (comptes réels du classifieur) + « visi ».
import Base from "../../layouts/Base.astro";
import { TAXONOMY } from "../../lib/taxonomy";
import { products } from "../../data/products.json";
import { SITE_NAME } from "../../lib/site";

const entries = [
  { id: "visi", label: "Visi produktai", count: products.length, image: products[0]?.image || "" },
  ...TAXONOMY.map((c) => ({ id: c.id, label: c.label, count: c.count, image: c.image })),
];
---
<Base
  title={`Kategorijos — ${SITE_NAME}`}
  description="Elektroninių cigarečių kategorijos: vienkartiniai garintuvai, e-skysčiai, nikotino pagalvėlės."
  canonicalPath="/kategorijos"
>
  <div class="mx-auto max-w-6xl px-3 py-6">
    <h1 class="mb-6 text-3xl font-black text-neutral-900 md:text-5xl">Kategorijos</h1>
    <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
      {entries.map((c) => (
        <a href={`/kategorijos/${c.id}`} class="group overflow-hidden rounded-lg border border-neutral-200 bg-white">
          <img src={c.image} alt={c.label} loading="lazy" class="aspect-square w-full object-cover" width="480" height="480" />
          <div class="p-3">
            <p class="font-semibold text-neutral-900 group-hover:text-primary">{c.label}</p>
            <p class="text-xs text-neutral-500">{c.count} produktai</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>