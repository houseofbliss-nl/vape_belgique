---
// Tiroir latéral gauche — reproduction de Sidebar.tsx vapespot (langue NL/FR/DE).
// Niveau catégorie → accordéon de sous-catégories → liens préfixés /{lang}/.
import { TAXONOMY } from "../lib/taxonomy";
import { getCount } from "../lib/store";
import Icon from "./Icon.astro";
import { t, p } from "../lib/i18n";
import type { Lang } from "../lib/i18n";

interface Props { lang: Lang; }
const { lang } = Astro.props;

const cats = TAXONOMY; // 4 catégories racines seules (plus « visi »)
const listCount = getCount();
const total = cats.reduce((s, c) => s + c.count, 0);
---
<aside
  id="sidebar"
  data-sidebar
  class="fixed top-0 left-0 z-50 h-full w-[300px] sm:w-[340px] bg-white overflow-y-auto shadow-xl -translate-x-full transition-transform duration-200"
>
  <!-- Entête -->
  <div class="px-5 pt-5 pb-4 flex items-center justify-between">
    <a href={p(lang, "/")} data-sidebar-close aria-label="vape24be" class="inline-block">
      <img src="/images/logo-vape24be.svg" alt="vape24be" class="h-8 w-auto" />
    </a>
    <button type="button" data-sidebar-close aria-label={t(lang, "nav.close")} class="p-1.5 text-black hover:opacity-70">
      <Icon name="x" class="h-5 w-5" />
    </button>
  </div>

  <div class="px-3 pb-4">
    <!-- Home -->
    <a href={p(lang, "/")} data-sidebar-close class="flex items-center gap-3 px-2 py-2.5 hover:bg-[#F5F5F7] transition-colors">
      <div class="h-10 w-10 rounded-full bg-[#F5F5F7] flex items-center justify-center overflow-hidden">
        <Icon name="home" class="h-5 w-5 text-[#6E6E73]" strokeWidth={1.75} />
      </div>
      <span class="text-[15px] font-semibold text-black">{t(lang, "nav.home")}</span>
    </a>

    <!-- My List -->
    <a href={p(lang, "/cart/")} data-sidebar-close class="flex items-center gap-3 px-2 py-2.5 hover:bg-[#F5F5F7] transition-colors">
      <div class="h-10 w-10 rounded-full bg-[#F5F5F7] flex items-center justify-center overflow-hidden">
        <Icon name="clipboard" class="h-5 w-5 text-[#6E6E73]" strokeWidth={1.75} />
      </div>
      <span class="text-[15px] font-medium text-[#6E6E73] flex-1">{t(lang, "nav.myList")}</span>
      <span id="sb-count" class={"min-w-[22px] h-[22px] px-1.5 rounded-full bg-[#ED2939] text-white text-[11px] font-semibold flex items-center justify-center " + (listCount > 0 ? "" : "hidden")}>{listCount}</span>
    </a>

    {/* Section catégories — accordéon sous-catégories */}
    <p class="px-2 pt-5 pb-2 text-[11px] font-semibold tracking-[0.1em] text-[#ED2939] uppercase">{t(lang, "nav.categories")}</p>

    <div class="space-y-0.5">
      {cats.map((cat) => (
        <div class="group/cat" data-cat>
          <button type="button" data-cat-toggle
            class="w-full flex items-center gap-3 px-2 py-3 hover:bg-[#F5F5F7] transition-colors">
            <img src={cat.image} alt="" loading="lazy" class="h-12 w-12 object-contain shrink-0" />
            <span class="text-[15px] font-medium text-black flex-1 text-left truncate">{t(lang, `cat.${cat.id}`)}</span>
            <span class="text-xs font-semibold text-[#ED2939]">{cat.count}</span>
            <Icon name="chevron-right" class="h-[18px] w-[18px] text-neutral-400 shrink-0 transition-transform duration-200" strokeWidth={2} />
          </button>

          {/* Sous-catégories — masquées par défaut, dépliées au clic */}
          <div data-cat-subs class="hidden pb-1">
            {cat.subs.map((s) => (
              <a href={p(lang, `/kategorijos/${cat.id}/${s.key}/`)} data-sidebar-close
                class="flex items-center gap-3 py-2 pl-6 pr-3 ml-7 border-l-2 border-[#F0F0F0] hover:border-[#ED2939] hover:bg-[#F8F8FA] transition-colors">
                <img src={s.image} alt="" loading="lazy" class="h-8 w-8 object-contain shrink-0" />
                <span class="text-[13px] font-medium text-neutral-700 flex-1 truncate">{t(lang, `sub.${s.key}`)}</span>
                <span class="text-[11px] text-neutral-500">{s.count}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    {/* Section zones de livraison */}
    <p class="px-2 pt-5 pb-2 text-[11px] font-semibold tracking-[0.1em] text-[#ED2939] uppercase">{t(lang, "nav.deliveryZones")}</p>
    <a href={p(lang, "/miestai/")} data-sidebar-close class="flex items-center gap-3 px-2 py-2.5 hover:bg-[#F5F5F7] transition-colors">
      <div class="h-10 w-10 rounded-full bg-[#F5F5F7] flex items-center justify-center overflow-hidden">
        <Icon name="truck" class="h-5 w-5 text-[#6E6E73]" strokeWidth={1.75} />
      </div>
      <span class="text-[15px] font-medium text-black flex-1">{t(lang, "nav.deliveryZones")}</span>
      <Icon name="chevron-right" class="h-[18px] w-[18px] text-neutral-400 shrink-0" strokeWidth={2} />
    </a>

    <a href="https://t.me/Vapelt_shop" target="_blank" rel="noopener noreferrer"
      class="mt-6 flex items-center gap-3 p-4 bg-[#F5F5F7]">
      <div class="h-10 w-10 rounded-full bg-black flex items-center justify-center text-[#F2C94C] shrink-0">
        <Icon name="send" class="h-5 w-5" strokeWidth={1.75} />
      </div>
      <div class="min-w-0">
        <p class="text-[11px] text-[#6E6E73]">{t(lang, "nav.contactUs")}</p>
        <p class="text-sm font-bold leading-tight text-black">Telegram</p>
        <p class="text-[11px] text-[#6E6E73]">{t(lang, "nav.replyFast")}</p>
      </div>
    </a>
  </div>
</aside>

<script>
  const sidebar = document.getElementById("sidebar");
  const openBtn = document.getElementById("sidebar-open");
  const closeBtns = document.querySelectorAll("[data-sidebar-close]");
  const open = () => {
    sidebar.classList.remove("-translate-x-full");
    document.body.style.overflow = "hidden";
  };
  const close = () => {
    sidebar.classList.add("-translate-x-full");
    document.body.style.overflow = "";
  };
  openBtn?.addEventListener("click", open);
  closeBtns.forEach((el) => el.addEventListener("click", close));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });

  // Accordéon sous-catégories : un seul bloc ouvert à la fois.
  document.querySelectorAll("[data-cat-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const subs = btn.parentElement.querySelector("[data-cat-subs]");
      const icon = btn.querySelector("svg");
      const isOpen = !subs.classList.contains("hidden");
      sidebar.querySelectorAll("[data-cat-subs]").forEach((el) => el.classList.add("hidden"));
      sidebar.querySelectorAll("[data-cat-toggle] svg").forEach((ic) => ic.classList.remove("rotate-180"));
      if (!isOpen) {
        subs.classList.remove("hidden");
        icon?.classList.add("rotate-180");
        subs.scrollIntoView({ block: "nearest" });
      }
    });
  });

  // Compteur panier sync
  const sbCount = document.getElementById("sb-count");
  const sync = () => {
    const raw = localStorage.getItem("vapelt:my-list") || "[]";
    try {
      const n = JSON.parse(raw).reduce((s, i) => s + i.quantity, 0);
      if (sbCount) { sbCount.textContent = String(n); sbCount.classList.toggle("hidden", n <= 0); }
    } catch {}
  };
  window.addEventListener("vapelt:storage", sync);
  window.addEventListener("storage", sync);
</script>