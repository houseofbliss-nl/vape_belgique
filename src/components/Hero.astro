---
// Hero — photo pleine largeur (desktop.png PC/tablette, mobile.png mobile),
// remplace l'ancienne bannière SVG (texte + fond supprimés sur décision utilisateur).
// Bouton Telegram superposé : conservé tant que l'utilisateur ne confirme pas qu'il
// est intégré dans l'image.
import { t } from "../lib/i18n";
import type { Lang } from "../lib/i18n";
interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<section class="relative w-full">
  <picture>
    <source media="(min-width: 768px)" srcset="/images/hero-desktop.png" />
    <img src="/images/hero-mobile.png" alt="VAPELT katalogas"
      loading="eager" decoding="async" fetchpriority="high"
      class="w-full h-auto block" />
  </picture>

  <!-- Bouton Telegram (blanc sur fond sombre — largement au-dessus de la zone
       bas-gauche sombre pour rester lisible sur desktop ; centré en mobile) -->
  <div class="absolute inset-x-0 bottom-[9%] flex justify-center px-6 -translate-y-[300%] md:inset-x-auto md:left-[12%] md:justify-start md:translate-y-[70%]">
    <a href="https://t.me/Vapelt_shop" target="_blank" rel="noopener noreferrer"
      class="inline-flex items-center gap-2 bg-white text-black font-bold rounded-lg px-8 py-3.5 hover:opacity-90 transition-opacity text-sm md:text-base shadow-lg">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 21.875L5.999 12Zm0 0h7.5"/></svg>
      {t(lang, "footer.contactTelegram")}
    </a>
  </div>
</section>