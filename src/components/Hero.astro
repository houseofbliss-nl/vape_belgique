---
// Hero — structure IDENTIQUE à VAPELT (hauteur naturelle w-full h-auto).
// Texte ancré EN HAUT, polices FLUIDES clamp() : elles grossissent avec l'écran
// (40px mobile → 88px desktop), donc chaque bloc = plus de lignes plus hautes
// → tout le bloc est poussé vers le bas et REMPLIT la photo sans déborder,
// sur mobile comme sur PC (comme sur un e-commerce moderne).
// Doux dégradé sombre en bas + à gauche pour la lisibilité des textes.
// CTA noir + texte JAUNE OR forcé en inline (Tailwind ne purge pas l'inline).
import { t, p } from "../lib/i18n";
import type { Lang } from "../lib/i18n";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const collectionLink = p(lang, "/kategorijos/");
const YELLOW = "#F2C94C";
---
<section class="relative w-full">
  <!-- Image : une seule selon le viewport, hauteur naturelle -->
  <picture>
    <source media="(min-width: 768px)" srcset="/images/hero-be-desktop.png" />
    <img
      src="/images/hero-be-mobile.png"
      alt=""
      role="presentation"
      loading="eager" decoding="async" fetchpriority="high"
      class="w-full h-auto block" />
  </picture>

  <!-- Dégradé sombre : bas (derrière CTA) + gauche (derrière texte) → lisibilité -->
  <div class="absolute inset-0" style="background:linear-gradient(to top,rgba(0,0,0,.78) 0%,rgba(0,0,0,.55) 28%,rgba(0,0,0,.32) 55%,rgba(0,0,0,.12) 78%,rgba(0,0,0,0) 95%),linear-gradient(to right,rgba(0,0,0,.6) 0%,rgba(0,0,0,.25) 45%,rgba(0,0,0,0) 70%)"></div>

  <!-- Contenu : ancré en HAUT, polices fluides qui poussent le texte vers le bas -->
  <div class="absolute inset-0 flex flex-col justify-start pt-[12%] md:pt-[10%] lg:pt-[8%]">
    <div class="w-full max-w-7xl mx-auto px-4 md:px-10">
      <div class="max-w-[640px] lg:max-w-[680px] text-white">
        <h1 class="text-[clamp(2.5rem,5.5vw,5.5rem)] leading-[1.05] font-extrabold drop-shadow">
          {t(lang, "hero.title")}
        </h1>
        <p class="mt-6 md:mt-8 text-[clamp(1.6rem,3.2vw,2.75rem)] leading-snug font-semibold text-white/95 drop-shadow">
          {t(lang, "hero.subtitle")}
        </p>
        <p class="mt-4 md:mt-5 text-[clamp(1.05rem,2vw,1.875rem)] leading-snug text-white/90 drop-shadow">
          {t(lang, "hero.desc")}
        </p>

        <!-- Arguments — TOUJOURS 2 colonnes (mobile, tablette, PC) : Produits originaux + Large sélection
             sur la 1re ligne (gauche/droite), Livraison rapide + Paiement sécurisé sur la 2e. -->
        <div class="mt-7 md:mt-9 grid grid-cols-2 gap-x-4 gap-y-2 sm:gap-x-6 sm:gap-y-3 text-[clamp(1rem,1.7vw,1.6rem)] font-semibold text-white/95">
          <span class="inline-flex items-center gap-2"><svg class="h-5 w-5" style={`color:${YELLOW}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>{t(lang, "hero.arg1")}</span>
          <span class="inline-flex items-center gap-2"><svg class="h-5 w-5" style={`color:${YELLOW}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>{t(lang, "hero.arg2")}</span>
          <span class="inline-flex items-center gap-2"><svg class="h-5 w-5" style={`color:${YELLOW}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M16 6V4H3v13h3"/><path d="M7 6h8"/><path d="M16 10h5l3 3v3h-2"/><circle cx="8" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>{t(lang, "hero.arg3")}</span>
          <span class="inline-flex items-center gap-2"><svg class="h-5 w-5" style={`color:${YELLOW}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h-1V6a5 5 0 0 0-10 0v2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V10a2 2 0 0 0-2-2z"/><path d="M12 14v4"/></svg>{t(lang, "hero.arg4")}</span>
        </div>

        <!-- CTA → collection : ROUGE + texte JAUNE OR (inline garanti) -->
        <div class="mt-8 md:mt-10">
          <a href={collectionLink}
            style={`background:#ED2939;color:${YELLOW}`}
            class="inline-flex items-center justify-center rounded-lg text-[clamp(1rem,1.5vw,1.375rem)] font-bold px-8 lg:px-10 py-4 lg:py-5 hover:opacity-90 focus:outline-none transition-opacity">
            {t(lang, "hero.cta")}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>