---
import { SITE_NAME, TELEGRAM_URL } from "../lib/site";
import { t, p } from "../lib/i18n";
import type { Lang } from "../lib/i18n";

interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<footer class="mt-12 border-t border-neutral-200 bg-neutral-100 pb-24 md:pb-0">
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-4 py-10 md:grid-cols-4">
    <div class="col-span-2 md:col-span-1">
      <p class="mb-3 text-xl font-black tracking-tight text-neutral-900">{SITE_NAME}</p>
      <p class="text-sm text-neutral-600">{t(lang, "footer.blurb")}</p>
    </div>

    <div>
      <p class="mb-3 text-sm font-semibold text-neutral-900">{t(lang, "footer.catsTitle")}</p>
      <ul class="space-y-2 text-sm text-neutral-600">
        <li><a href={p(lang, "/kategorijos")} class="hover:text-neutral-900">{t(lang, "footer.allProducts")}</a></li>
        <li><a href={p(lang, "/kategorijos/vienkartiniai")} class="hover:text-neutral-900">{t(lang, "footer.disposable")}</a></li>
        <li><a href={p(lang, "/kategorijos/esultys")} class="hover:text-neutral-900">{t(lang, "footer.eliquids")}</a></li>
        <li><a href={p(lang, "/kategorijos/nicotine-pouches")} class="hover:text-neutral-900">{t(lang, "footer.pouches")}</a></li>
      </ul>
    </div>

    <div>
      <p class="mb-3 text-sm font-semibold text-neutral-900">{t(lang, "footer.linksTitle")}</p>
      <ul class="space-y-2 text-sm text-neutral-600">
        <li><a href={p(lang, "/apie")} class="hover:text-neutral-900">{t(lang, "footer.about")}</a></li>
        <li><a href={p(lang, "/zinios")} class="hover:text-neutral-900">{t(lang, "footer.news")}</a></li>
        <li><a href={p(lang, "/privacy")} class="hover:text-neutral-900">{t(lang, "footer.privacy")}</a></li>
        <li><a href={p(lang, "/cart")} class="hover:text-neutral-900">{t(lang, "footer.myList")}</a></li>
      </ul>
    </div>

    <div>
      <p class="mb-3 text-sm font-semibold text-neutral-900">{t(lang, "footer.contactTitle")}</p>
      <p class="mb-2 text-sm text-neutral-600">{t(lang, "footer.orderViaTelegram")}</p>
      <a
        href={TELEGRAM_URL}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 whitespace-nowrap rounded-lg px-4 py-2 text-sm font-semibold"
        style="background:#000;color:#F2C94C"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path></svg>
        {t(lang, "footer.contactTelegram")}
      </a>
    </div>
  </div>

  <div class="border-t border-neutral-800 bg-[#0A0F0F] py-5">
    <p class="mx-auto max-w-6xl px-4 text-center text-xs text-neutral-400">
      {t(lang, "footer.copyright", { year: new Date().getFullYear(), name: SITE_NAME })}
    </p>
  </div>
</footer>