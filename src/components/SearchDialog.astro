---
// Boîte de recherche — reproduction de SearchDialog.tsx vapespot (vanilla JS).
// S'ouvre via l'événement "vapelt:search". Cherche dans /data/search.json (format compact).
import { t } from "../lib/i18n";
import type { Lang } from "../lib/i18n";
const { limit = 25, lang } = Astro.props;
const all = Math.max(1, Math.floor(Number(limit) || 25));
const searchPlaceholder = t(lang, "search.searchPlaceholder");
const searchClear = t(lang, "search.clear");
const searchError = t(lang, "search.error");
const searchNoResults = t(lang, "search.noResults");
const prefix = `/${lang}/`;
---
<div id="search-root" class="fixed inset-0 z-50 hidden">
  <div class="fixed inset-0 bg-black/50" data-search-close></div>
  <div class="fixed left-0 right-0 mx-auto max-w-xl top-[10%] bg-white translate-y-[-20px]">
    <div class="flex items-center gap-2 border-b px-4 h-14">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-[#6E6E73]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.3-4.3"/></svg>
      <input id="search-input" type="text" placeholder={searchPlaceholder} class="flex-1 bg-transparent outline-none text-sm" autocomplete="off">
      <button type="button" id="search-clear" aria-label={searchClear} class="hidden">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#6E6E73]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18 6 6 18"/><path stroke-linecap="round" stroke-linejoin="round" d="m6 6 12 12"/></svg>
      </button>
    </div>
    <div id="search-results" class="max-h-[60vh] overflow-y-auto"></div>
  </div>
</div>

<script define:vars={{ all, searchPlaceholder, searchClear, searchError, searchNoResults, prefix }}>
  const root = document.getElementById("search-root");
  const input = document.getElementById("search-input");
  const resultsEl = document.getElementById("search-results");
  const clearBtn = document.getElementById("search-clear");
  let INDEX = null;
  let open = false;

  function normalize(s) {
    return String(s || "").toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
  }

  function run(q) {
    if (!q || !q.trim()) {
      clearBtn.classList.add("hidden");
      resultsEl.innerHTML = "";
      return;
    }
    clearBtn.classList.remove("hidden");
    if (!INDEX) {
      fetch("/data/search.json").then((r) => r.json()).then((d) => {
        INDEX = d;
        render(normalize(q.trim()));
      }).catch(() => {
        resultsEl.innerHTML = `<p class="p-6 text-sm text-center">${searchError}</p>`;
      });
      return;
    }
    render(normalize(q.trim()));
  }

  function render(needle) {
    const matches = [];
    for (const d of INDEX) {
      if (matches.length >= all) break;
      if (normalize(d.t + " " + d.v).includes(needle)) matches.push(d);
    }
    if (!matches.length) {
      resultsEl.innerHTML = `<p class="p-6 text-sm text-[#6E6E73] text-center">${searchNoResults}</p>`;
      return;
    }
    resultsEl.innerHTML = matches.map((d) => `
      <a href="${prefix}produktis/${d.h}/" class="flex items-center gap-3 p-3 hover:bg-[#F5F5F7] transition-colors">
        <img src="${d.i}" alt="" loading="lazy" class="h-10 w-10 object-contain border border-[#EEE] rounded bg-white">
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium truncate">${(d.t || "").replace(/"/g, "&quot;")}</p>
          ${d.v ? `<p class="text-xs text-[#6E6E73]">${(d.v).replace(/"/g, "&quot;")}</p>` : ""}
        </div>
        <span class="text-sm font-semibold" translate="no">${Number(d.p).toFixed(2).replace(".", ",")} €</span>
      </a>`).join("");
  }

  function openDialog() {
    open = true;
    root.classList.remove("hidden");
    setTimeout(() => input.focus(), 30);
    document.addEventListener("keydown", esc);
  }
  function closeDialog() {
    open = false;
    root.classList.add("hidden");
    resultsEl.innerHTML = "";
    input.value = "";
    clearBtn.classList.add("hidden");
    document.removeEventListener("keydown", esc);
  }
  function esc(e) {
    if (e.key === "Escape") closeDialog();
  }

  input.addEventListener("input", () => run(input.value));
  clearBtn.addEventListener("click", () => { input.value = ""; run(); input.focus(); });
  root.addEventListener("click", (e) => {
    if (e.target.closest("[data-search-close]")) closeDialog();
  });
  window.addEventListener("vapelt:search", openDialog);
</script>