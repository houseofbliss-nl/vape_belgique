const { name, class: cls = "h-4 w-4", strokeWidth = 2, fill = "none" } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  class={cls}
  fill={fill}
  viewBox="0 0 24 24"
  stroke="currentColor"
  stroke-width={strokeWidth}
