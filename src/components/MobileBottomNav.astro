---
// Navigation basse mobile — reproduction EXACTE de MobileBottomNav.tsx vapespot.
// 4 entrées : Accueil / Recherche / Liste / Telegram. La recherche ouvre SearchDialog.
import Icon from "./Icon.astro";
import { t, p } from "../lib/i18n";
import type { Lang } from "../lib/i18n";
import { getCount } from "../lib/store";

interface Props { lang: Lang; hide?: boolean; }
const { lang, hide = false } = Astro.props;
const count = getCount();
const path = Astro.url.pathname;
const homePath = p(lang, "/");
const cartPath = p(lang, "/cart/");
const isActive = (pp) => path === pp;
const iconClass = (active) => `h-5 w-5 ${active ? "text-[#ED2939]" : "text-black"}`;
const labelClass = (active) => `text-[10px] mt-0.5 ${active ? "text-[#ED2939] font-semibold" : "text-black"}`;
---
<nav class={"md:hidden fixed bottom-0 left-0 right-0 z-30 bg-white border-t border-[#F0F0F0] h-[60px] flex items-stretch " + (hide ? "hidden" : "")}>
  <a href={homePath} class="flex-1 flex flex-col items-center justify-center">
    <Icon name="home" class={iconClass(isActive(homePath))} />
    <span class={labelClass(isActive(homePath))}>{t(lang, "nav.home")}</span>
  </a>
  <button type="button" data-open-search-mobile class="flex-1 flex flex-col items-center justify-center">
    <Icon name="search" class="h-5 w-5 text-black" />
    <span class="text-[10px] mt-0.5 text-black">{t(lang, "nav.search")}</span>
  </button>
  <a href={cartPath} class="flex-1 flex flex-col items-center justify-center relative">
    <div class="relative">
      <Icon name="clipboard" class={iconClass(isActive(cartPath))} />
      <span id="mn-count" class={"absolute -top-1 -right-2 min-w-[16px] h-[16px] px-1 rounded-full bg-[#ED2939] text-white text-[9px] font-semibold flex items-center justify-center " + (count > 0 ? "" : "hidden")}>{count}</span>
    </div>
    <span class={labelClass(isActive(cartPath))}>{t(lang, "nav.myList")}</span>
  </a>
  <a href="https://t.me/Vapelt_shop" target="_blank" rel="noopener noreferrer" class="flex-1 flex flex-col items-center justify-center">
    <Icon name="send" class="h-5 w-5 text-black" />
    <span class="text-[10px] mt-0.5 font-bold text-black">Telegram</span>
  </a>
</nav>

<script>
  const mn = document.getElementById("mn-count");
  const sync = () => {
    if (!mn) return;
    const raw = localStorage.getItem("vapelt:my-list") || "[]";
    try {
      const n = JSON.parse(raw).reduce((s, i) => s + i.quantity, 0);
      mn.textContent = String(n);
      mn.classList.toggle("hidden", n <= 0);
    } catch {}
  };
  // Le bouton Recherche mobile ouvre le même SearchDialog que le header.
  document.querySelector("[data-open-search-mobile]")?.addEventListener("click", () =>
    window.dispatchEvent(new CustomEvent("vapelt:search"))
  );
  window.addEventListener("vapelt:storage", sync);
  window.addEventListener("storage", sync);
</script>